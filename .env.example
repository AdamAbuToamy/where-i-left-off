# PUBLIC browser identifiers, included in the built JavaScript. Not secret storage.
# Restrict this Firebase Web key to required Firebase APIs in Google Cloud.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise SITE key. Never put a secret key here.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Production deploy script requires both; ordinary builds may show setup mode.
VITE_REQUIRE_APP_CHECK=false
VITE_REQUIRE_FIREBASE_CONFIG=false
# Local automated tests only. Never connect an emulator build to real projects.
VITE_USE_EMULATORS=false
VITE_TEST_OFFLINE=false
VITE_EMULATOR_HOST=127.0.0.1
# SERVER ONLY: FIREBASE_SERVICE_ACCOUNT and SMTP_CONFIG belong in CI secrets.
# Never prefix server credentials with VITE_ or copy them into public/ or src/.
