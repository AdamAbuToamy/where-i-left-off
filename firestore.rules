rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validInteger(value, maximum) {
      return value is int && value >= 0 && value <= maximum;
    }
    function validText(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function validOptionalUrl(value) {
      return value is string && value.size() <= 500 && (value == '' || value.matches('^https?://[^\\s]+$'));
    }
    function validOptionalDate(value) {
      return value is string && (value == '' || value.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$'));
    }
    function validWorkflowFields(d) {
      return d.get('resourceType', 'project') in ['project','book','course','video','series','film','shopping','idea']
        && validInteger(d.get('archivedAt', 0), 9000000000000000)
        && validInteger(d.get('trashedAt', 0), 9000000000000000)
        && validInteger(d.get('activityAt', 0), 9000000000000000)
        && validInteger(d.get('completedAt', 0), 9000000000000000)
        && validInteger(d.get('progressUnits', 0), 1000000)
        && validInteger(d.get('totalUnits', 0), 1000000)
        && validText(d.get('description', ''), 1000)
        && validText(d.get('catalogSource', ''), 30)
        && validText(d.get('catalogId', ''), 100)
        && validOptionalUrl(d.get('coverUrl', ''))
        && validOptionalDate(d.get('followUpDate', ''));
    }
    function validExtraLink(value) {
      return value is string && value.size()<=500 && value.matches('^https?://[^\\s]+$');
    }
    function validExtraLinks(links) {
      let count = links.size();
      return links is list && count<=10
        && (count<=0 || validExtraLink(links[0]))
        && (count<=1 || validExtraLink(links[1]))
        && (count<=2 || validExtraLink(links[2]))
        && (count<=3 || validExtraLink(links[3]))
        && (count<=4 || validExtraLink(links[4]))
        && (count<=5 || validExtraLink(links[5]))
        && (count<=6 || validExtraLink(links[6]))
        && (count<=7 || validExtraLink(links[7]))
        && (count<=8 || validExtraLink(links[8]))
        && (count<=9 || validExtraLink(links[9]))
        ;
    }
      function validProject() {
        let d = request.resource.data;
        let keys = d.keys();
        return keys.hasAll(['name', 'nextStep', 'status', 'rank', 'revision', 'updatedAt'])
          && keys.hasOnly(['name', 'nextStep', 'projectUrl', 'attachmentUrl', 'links', 'dueDate', 'assignedTo', 'sectionId', 'kind', 'checkpoint', 'checklist', 'mutationId', 'archivedAt', 'trashedAt', 'activityAt', 'completedAt', 'resourceType', 'progressUnits', 'totalUnits', 'followUpDate', 'coverUrl', 'description', 'catalogSource', 'catalogId', 'status', 'rank', 'revision', 'updatedAt'])
          && d.name is string && d.name.size() <= 100
          && d.name.matches('.*[^\\s].*')
          && validExtraLinks(d.get('links', []))
          && validWorkflowFields(d)
          && validText(d.nextStep, 1000)
          && validOptionalUrl(d.get('projectUrl', ''))
          && validOptionalUrl(d.get('attachmentUrl', ''))
          && validOptionalDate(d.get('dueDate', ''))
          && validText(d.get('assignedTo', ''), 128)
          && validText(d.get('sectionId', ''), 100)
          && d.get('kind', 'resume') in ['resume', 'waiting', 'deadline', 'list']
          && validText(d.get('checkpoint', ''), 1000)
          && validText(d.get('checklist', ''), 3000)
          && validText(d.get('mutationId', ''), 100)
          && d.status in ['later', 'active', 'waiting', 'done']
          && d.rank is number && d.rank > -1000000000000000 && d.rank < 1000000000000000
          && d.revision is int && d.revision >= 0
          && d.updatedAt == request.time;
      }
      function validSection() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'updatedAt']) && d.keys().hasOnly(['name', 'updatedAt', 'revision', 'mutationId'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.name.matches('.*[^\\s].*') && d.updatedAt == request.time
          && (!d.keys().hasAny(['revision']) || d.revision is int && d.revision >= 0)
          && (!d.keys().hasAny(['mutationId']) || d.mutationId is string && d.mutationId.size() <= 100);
      }
    match /users/{uid}/studyRecords/{recordId} {
      function owner() { return signedActive() && request.auth.uid == uid && request.auth.token.email_verified == true; }
      function validStudyRecord() {
        let d=request.resource.data;
        return d.keys().hasOnly(['kind','id','payload','deleted','revision','mutationId','updatedAt'])
          && d.keys().hasAll(['kind','id','payload','deleted','revision','mutationId','updatedAt'])
          && d.kind in ['courses','tasks','lessons']
          && d.id is string && d.id.size()>0 && d.id.size()<=600 && d.id.matches('^[A-Za-z0-9_-]+$')
          && recordId==d.kind+'_'+d.id && validText(d.payload,600000)
          && d.deleted is bool && (!d.deleted || d.payload=='')
          && validText(d.mutationId,100) && d.mutationId.size()>0
          && d.revision is int && d.revision>=0 && d.updatedAt==request.time;
      }
      allow read: if owner();
      allow create: if owner() && validStudyRecord() && request.resource.data.revision==0;
      allow update: if owner() && validStudyRecord() && request.resource.data.revision==resource.data.revision+1;
      // Tombstones keep another device from silently recreating a deleted item.
      allow delete: if false;
    }

    match /users/{uid}/projects/{projectId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function activeAccount() {
        let path = /databases/$(database)/documents/appMetrics/$(uid);
        return (!exists(path) || get(path).data.get('suspended', false) != true)
          && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
      }
      allow read, delete: if owner() && activeAccount();
      allow create: if owner() && activeAccount() && validProject() && request.resource.data.revision == 0;
      allow update: if owner() && activeAccount() && validProject() && request.resource.data.revision == resource.data.revision + 1;
    }

    match /users/{uid}/sections/{sectionId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function activeAccount() {
        let path = /databases/$(database)/documents/appMetrics/$(uid);
        return (!exists(path) || get(path).data.get('suspended', false) != true)
          && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
      }
      allow read, delete: if owner() && activeAccount();
      allow create: if owner() && activeAccount() && validSection() && request.resource.data.get('revision', 0) == 0;
      allow update: if owner() && activeAccount() && validSection()
        && (request.resource.data.keys().hasAny(['revision'])
          ? request.resource.data.revision == resource.data.get('revision', 0) + 1
          : !resource.data.keys().hasAny(['revision']));
    }

    function signedActive() {
      return request.auth != null && (!exists(/databases/$(database)/documents/appMetrics/$(request.auth.uid))
        || get(/databases/$(database)/documents/appMetrics/$(request.auth.uid)).data.get('suspended', false) != true)
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function groupMember(gid) {
      return signedActive() && exists(/databases/$(database)/documents/groups/$(gid))
        && get(/databases/$(database)/documents/groups/$(gid)).data.get('deleted', false) == false
        && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }
    function groupManager(gid) {
      return groupMember(gid) && get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role == 'manager';
    }
    function cleaningOwner(gid) {
      return signedActive() && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/groups/$(gid)).data.get('deleted', false) == true;
    }
    function ownerAfter(gid) {
      return getAfter(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid;
    }
    match /groups/{gid} {
      allow get: if groupMember(gid) || cleaningOwner(gid);
      allow list: if false;
      allow update: if signedActive() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) && request.resource.data.deleted == true;
      allow delete: if cleaningOwner(gid);
      allow create: if signedActive() && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.name.matches('.*[^\\s].*')
        && getAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role == 'manager';
      match /members/{memberUid} {
        function validMember() {
          let d = request.resource.data;
          return d.keys().hasAll(['name', 'email', 'role', 'joinedAt']) && d.keys().hasOnly(['name', 'email', 'role', 'joinedAt', 'inviteId', 'canCreate'])
            && d.name is string && d.name.size() <= 100
            && d.email == request.auth.token.email && d.joinedAt == request.time
            && (!d.keys().hasAny(['canCreate']) || d.canCreate == true);
        }
        function validInvitation() {
          let invite = get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId));
          return invite.data.groupId == gid && invite.data.expiresAt > request.time;
        }
        allow get: if signedActive() && (request.auth.uid == memberUid || groupMember(gid) || cleaningOwner(gid));
        allow list: if groupMember(gid) || cleaningOwner(gid);
        allow create: if signedActive() && request.auth.uid == memberUid && validMember()
          && ((ownerAfter(gid) && request.resource.data.role == 'manager' && !request.resource.data.keys().hasAny(['inviteId']))
            || (request.resource.data.role == 'member' && validInvitation() && getAfter(/databases/$(database)/documents/groups/$(gid)).data.get('deleted', false) == false))
          && getAfter(/databases/$(database)/documents/users/$(memberUid)/groupMemberships/$(gid)).data.role == request.resource.data.role;
        allow update: if (groupManager(gid) && resource.data.role == 'member'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canCreate']) && request.resource.data.canCreate is bool)
          || (groupMember(gid) && request.auth.uid == memberUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
            && request.resource.data.name.matches('.*[^\\s].*'));
        allow delete: if (cleaningOwner(gid) || (groupManager(gid) && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid != memberUid))
          && !existsAfter(/databases/$(database)/documents/users/$(memberUid)/groupMemberships/$(gid));
      }
      match /projects/{projectId} {
        function assignmentValid() {
          return request.resource.data.get('assignedTo', '') == ''
            || exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.resource.data.assignedTo));
        }
        allow read: if groupMember(gid) || cleaningOwner(gid);
        allow create: if groupMember(gid)
          && (get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role == 'manager'
            || (get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.get('canCreate', true) == true
              && request.resource.data.get('assignedTo', '') == request.auth.uid))
          && validProject() && assignmentValid() && request.resource.data.revision == 0;
        allow delete: if groupManager(gid) || cleaningOwner(gid);
        allow update: if groupMember(gid) && validProject() && request.resource.data.revision == resource.data.revision + 1
          && ((get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role == 'manager' && assignmentValid())
            || (resource.data.get('assignedTo', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextStep', 'status', 'checkpoint', 'checklist', 'progressUnits', 'followUpDate', 'activityAt', 'completedAt', 'revision', 'updatedAt', 'mutationId'])));
      }
      match /sections/{sectionId} {
        allow read: if groupMember(gid) || cleaningOwner(gid);
        allow delete: if groupManager(gid) || cleaningOwner(gid);
        allow create: if groupManager(gid) && validSection() && request.resource.data.get('revision', 0) == 0;
        allow update: if groupManager(gid) && validSection() && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      }
      match /announcements/{announcementId} {
        allow read: if groupMember(gid) || cleaningOwner(gid);
        allow create: if groupManager(gid)
          && request.resource.data.keys().hasOnly(['title','body','authorUid','authorName','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=100
          && request.resource.data.body is string && request.resource.data.body.size()>0 && request.resource.data.body.size()<=2000
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size()>0 && request.resource.data.authorName.size()<=100
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if groupManager(gid) || cleaningOwner(gid);
      }
    }
    match /users/{uid}/groupMemberships/{gid} {
      function matchingIndex() {
        let member = getAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid));
        return request.resource.data.keys().hasOnly(['groupName', 'role'])
          && request.resource.data.groupName == getAfter(/databases/$(database)/documents/groups/$(gid)).data.name
          && request.resource.data.role == member.data.role;
      }
      allow read: if signedActive() && request.auth.uid == uid;
      allow create, update: if signedActive() && request.auth.uid == uid && matchingIndex();
      allow delete: if (groupManager(gid) || cleaningOwner(gid)) && !existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid));
    }
    match /groupInvites/{token} {
      allow get: if signedActive() && (resource.data.expiresAt > request.time || groupManager(resource.data.groupId) || cleaningOwner(resource.data.groupId));
      allow list: if groupManager(resource.data.groupId) || cleaningOwner(resource.data.groupId);
      allow create: if signedActive() && groupManager(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.groupName == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.name
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if false;
      allow delete: if groupManager(resource.data.groupId) || cleaningOwner(resource.data.groupId);
    }

    function logAdmin() {
      return signedActive() && request.auth.token.email == 'adam2002hosny@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /feedback/{id} {
      function validFeedback() {
        let d = request.resource.data;
        let rate = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/supportRate/state).data;
        return request.auth != null
          && d.keys().hasAll(['uid','kind','subject','message','language','status','reply','createdAt','updatedAt'])
          && d.keys().hasOnly(['uid','kind','subject','message','language','status','reply','createdAt','updatedAt'])
          && d.uid == request.auth.uid && d.kind in ['suggestion','bug','privacy','deletion']
          && d.subject is string && d.subject.size() >= 3 && d.subject.size() <= 120 && d.subject.matches('.*[^\\s].*')
          && d.message is string && d.message.size() >= 10 && d.message.size() <= 3000 && d.message.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && d.language in ['ar','en','he'] && d.status == 'open' && d.reply == ''
          && d.createdAt == request.time && d.updatedAt == request.time
          && rate.lastId == id && rate.submittedAt == request.time;
      }
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || logAdmin());
      allow create: if request.auth != null && validFeedback();
      allow update: if logAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reply','updatedAt'])
        && request.resource.data.status in ['open','reviewing','closed']
        && request.resource.data.reply is string && request.resource.data.reply.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/supportRate/state {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['submittedAt','lastId'])
        && request.resource.data.keys().hasOnly(['submittedAt','lastId'])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.lastId is string && request.resource.data.lastId.matches('^[a-zA-Z0-9]{20}$')
        && (!exists(/databases/$(database)/documents/users/$(uid)/supportRate/state)
          || request.time >= resource.data.submittedAt + duration.value(1,'m'))
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastId)).data.createdAt == request.time;
    }

    match /appLogs/{logId} {
      function validLog() {
        let d = request.resource.data;
        return signedActive() && d.keys().hasAll(['id', 'uid', 'timestamp', 'level', 'event', 'code', 'page', 'environment', 'version', 'durationMs', 'source', 'receivedAt'])
          && d.keys().hasOnly(['id', 'uid', 'timestamp', 'level', 'event', 'code', 'page', 'environment', 'version', 'durationMs', 'source', 'receivedAt'])
          && d.id == logId && d.uid == request.auth.uid
          && d.timestamp is string && d.timestamp.size() <= 40
          && d.level in ['info', 'warn', 'error']
          && d.event is string && d.event.matches('^[a-zA-Z0-9._-]{1,60}$')
          && d.code is string && d.code.matches('^[a-zA-Z0-9/_-]{1,80}$')
          && d.page is string && d.page.size() <= 80
          && d.environment in ['emulator', 'development', 'production']
          && d.version is string && d.version.size() <= 40
          && d.source is string && d.source.size() <= 500
          && d.durationMs is int && d.durationMs >= 0 && d.durationMs <= 3600000
          && d.receivedAt == request.time;
      }
      allow read: if logAdmin();
      allow create: if validLog();
      // Repeat uploads of the same device event are idempotent; payload edits are rejected.
      allow update: if validLog() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt']);
      allow delete: if logAdmin();
    }


    match /system/accountDeletionWorker {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /accountDeletions/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function recentIdentity() {
        return request.auth.token.auth_time is int
          && request.time.toMillis() / 1000 - request.auth.token.auth_time < 300;
      }
      allow get: if owner();
      allow list, update: if false;
      allow create: if owner() && recentIdentity()
        && request.auth.token.email != 'adam2002hosny@gmail.com'
        && request.resource.data.keys().hasOnly(['status', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && get(/databases/$(database)/documents/system/accountDeletionWorker).data.availableUntil > request.time;
      allow delete: if owner() && recentIdentity() && resource.data.status == 'pending'
        && request.time < resource.data.requestedAt + duration.value(24, 'h');
    }

    match /system/securityEmailWorker {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /securityNotifications/{uid} {
      function validNotice() {
        return signedActive() && request.auth.uid == uid && request.auth.token.email_verified == true
          && request.time.toMillis() / 1000 - request.auth.token.auth_time < 300
          && request.resource.data.keys().hasOnly(['status','event','language','requestedAt'])
          && request.resource.data.status == 'pending' && request.resource.data.event == 'password-changed'
          && request.resource.data.language in ['ar','en','he'] && request.resource.data.requestedAt == request.time
          && get(/databases/$(database)/documents/system/securityEmailWorker).data.availableUntil > request.time;
      }
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if validNotice();
      allow update: if validNotice() && resource.data.status != 'processing'
        && request.time > resource.data.requestedAt + duration.value(1,'m');
    }


    match /users/{uid}/preferences/{preference} {
      function ownerPreference() { return signedActive() && request.auth.uid==uid && preference=='workflow'; }
      allow get: if ownerPreference();
      allow list,delete: if false;
      allow create,update: if ownerPreference()
        && request.resource.data.keys().hasOnly(['autoArchive','reminders','desktop','reviewDays','updatedAt'])
        && request.resource.data.autoArchive is bool && request.resource.data.reminders is bool && request.resource.data.desktop is bool
        && request.resource.data.reviewDays in [7,14,30,60,90] && request.resource.data.updatedAt==request.time;
    }
    match /users/{uid}/sessions/{sessionId} {
      function validSession() {
        let d=request.resource.data;
        return signedActive() && request.auth.uid==uid
          && d.keys().hasOnly(['projectId','projectName','groupId','resourceType','startedAt','endedAt','seconds','checkpoint','nextStep','receivedAt'])
          && d.projectId is string && d.projectId.size()>0 && d.projectId.size()<=100
          && d.projectName is string && d.projectName.size()>0 && d.projectName.size()<=100
          && d.groupId is string && d.groupId.size()<=100
          && d.resourceType in ['project','book','course','video','series','film','shopping','idea']
          && d.startedAt is int && d.startedAt>=0 && d.endedAt is int && d.endedAt>=d.startedAt
          && d.seconds is int && d.seconds>=0 && d.seconds<=5400
          && d.seconds*1000<=d.endedAt-d.startedAt+1000
          && d.checkpoint is string && d.checkpoint.size()<=1000 && d.nextStep is string && d.nextStep.size()<=1000
          && d.receivedAt==request.time;
      }
      allow read: if signedActive() && request.auth.uid==uid;
      allow create: if validSession();
      allow update: if validSession() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt']);
      allow delete: if signedActive() && request.auth.uid==uid;
    }
    match /appMetrics/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function admin() {
        return signedActive()
          && request.auth.token.email == 'adam2002hosny@gmail.com'
          && request.auth.token.email_verified == true;
      }
      function validOwnerMetric() {
        let d = request.resource.data;
        return d.keys().hasAll(['firstSeen', 'lastSeen', 'email', 'suspended'])
          && d.keys().hasOnly(['firstSeen', 'lastSeen', 'email', 'suspended'])
          && d.firstSeen is timestamp && d.lastSeen == request.time
          && d.email is string && d.email == request.auth.token.email
          && d.suspended is bool;
      }
      allow get: if owner() || admin();
      allow list: if admin();
      allow create: if owner() && signedActive() && validOwnerMetric()
        && request.resource.data.firstSeen == request.time
        && request.resource.data.suspended == false;
      allow update: if (owner() && signedActive() && validOwnerMetric()
          && request.resource.data.firstSeen == resource.data.firstSeen
          && request.resource.data.suspended == resource.data.get('suspended', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'email', 'suspended']))
        || (admin() && resource.data.email != 'adam2002hosny@gmail.com'
          && request.resource.data.email != 'adam2002hosny@gmail.com'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
          && request.resource.data.suspended is bool);
      allow delete: if false;
    }
  }
}
